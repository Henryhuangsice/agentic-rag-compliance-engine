# ---- LLM (any OpenAI-compatible endpoint). Leave LLM_API_KEY empty for offline extractive mode.
# DeepSeek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat            # or deepseek-reasoner (R1)
LLM_API_KEY=
# Zhipu GLM-4-Flash (free tier) — key from open.bigmodel.cn
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash
# Qwen via DashScope
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# Local Ollama (docker compose --profile ollama up)
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_API_KEY=ollama

# ---- Retrieval
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base   # empty = disable reranker
RELEVANCE_THRESHOLD=0.03
MAX_REWRITES=1

# ---- Model downloads. Uncomment if huggingface.co is slow or blocked in your network.
# HF_ENDPOINT=https://hf-mirror.com

# ---- Optional LangSmith tracing (LangGraph picks these up automatically)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=agentic-rag-compliance-engine
