{
  "name": "@rag/gateway",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --alias:@rag/shared=../shared/src/index.ts --outfile=dist/index.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/static": "^10.1.12",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
