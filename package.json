{
  "name": "agentic-rag-console",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "gateway",
    "web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:gateway": "npm run dev -w gateway",
    "dev:web": "npm run dev -w web",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "build": "npm run build -w web && npm run build -w gateway",
    "start": "npm run start -w gateway"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
